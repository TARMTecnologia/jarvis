# JARVIS Environment Configuration (Apenas para Desenvolvimento)
# Em produção, as chaves são salvas com segurança no Windows Credential Locker via Keyring.

# Provedor ativo: "openai", "gemini", ou "claude"
JARVIS_AI_PROVIDER=openai

# Modelos recomendados (opcional - usa padrão se vazio)
# OpenAI: gpt-4o ou gpt-4o-mini ou gpt-4o-realtime-preview
# Gemini: gemini-2.0-flash ou gemini-1.5-pro
# Claude: claude-3-5-sonnet-20241022 ou claude-3-5-haiku-20241022
JARVIS_AI_MODEL=gpt-4o-mini

# Chaves de API (Preencha APENAS UMA de acordo com o provedor escolhido)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Áudio e Voz
JARVIS_WAKE_WORD=Jarvis
JARVIS_VOICE_MODE=wakeword  # "wakeword", "continuous", "push_to_talk"

# Configurações de Diretórios
JARVIS_DATA_DIR=data
JARVIS_LOG_DIR=logs
